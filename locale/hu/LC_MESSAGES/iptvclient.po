#: catchup_urls.py:89
msgid "The connection to the provider timed out."
msgstr "Időtúllépés történt a szolgáltatóhoz való kapcsolódás közben."

#: updater.py:152
msgid "The installer could not be started."
msgstr "A telepítőt nem sikerült elindítani."

#: updater.py:156
msgid "The installer stopped with exit code {code}."
msgstr "A telepítő {code} kilépési kóddal leállt."

#: updater.py:154
msgid "The installer was still running after 15 minutes."
msgstr "A telepítő 15 perc után is még futott."

#: main.py:4422
msgid "The language has been changed. Please restart Accessible IPTV Client for the change to take full effect."
msgstr "A program nyelve megváltozott. A módosítás teljes érvénybe lépéséhez indítsa újra az Accessible IPTV Client alkalmazást."

#: D:/a/Accessible-IPTV-Client/Accessible-IPTV-Client/client_timeshift.py:60
msgid "The local buffer is still feeding a recording. Stop the recording before disabling it."
msgstr "A helyi tároló még folyamatban lévő felvételt szolgál ki. Kikapcsolása előtt állítsa le a rögzítést."

#: D:/a/Accessible-IPTV-Client/Accessible-IPTV-Client/client_timeshift.py:307
msgid "The local buffer stopped because its storage or input failed."
msgstr "A helyi tárolás háttértár- vagy adatforráshiba miatt leállt."

#: D:/a/Accessible-IPTV-Client/Accessible-IPTV-Client/client_timeshift.py:226
msgid "The local live buffer could not start. No extra provider connection was opened. Disable the buffer to retry direct playback."
msgstr "Az élő adás helyi tárolását nem sikerült elindítani. Nem nyílt további szolgáltatói kapcsolat. A közvetlen lejátszás ismételt megkísérléséhez kapcsolja ki a helyi tárolást."

#: D:/a/Accessible-IPTV-Client/Accessible-IPTV-Client/client_timeshift.py:311
msgid "The old buffered position expired; playback moved to the retained window."
msgstr "A korábbi pozíció már nem érhető el; a lejátszás a megőrzött tartományra lépett."

#: main.py:1895
msgid "The passwords do not match."
msgstr "A megadott jelszavak nem egyeznek."

#: D:/a/Accessible-IPTV-Client/Accessible-IPTV-Client/client_timeshift.py:296
msgid "The paused position expired. Playback resumed at the oldest retained picture."
msgstr "A szüneteltetés helye már nem érhető el. A lejátszás a legrégebbi megőrzött képtől folytatódik."

#: catchup_urls.py:75
msgid "The provider asked for a login (HTTP 401 Unauthorized). Check the playlist's user name and password."
msgstr "A szolgáltató bejelentkezést kér (HTTP 401 Unauthorized). Ellenőrizze a lejátszási lista felhasználónevét és jelszavát."

#: catchup_urls.py:78
msgid "The provider does not have this programme (HTTP 404 Not Found). It may be older than the provider's archive."
msgstr "Ez a műsor nem érhető el a szolgáltatónál (HTTP 404 Not Found). Lehetséges, hogy már kívül esik a szolgáltató által megőrzött időszakon."

#: catchup_urls.py:71
msgid "The provider refused access (HTTP 403 Forbidden). Many providers allow only one stream per account at a time: stop other playback or downloads from this account and try again."
msgstr "A szolgáltató megtagadta a hozzáférést (HTTP 403 Forbidden). Sok szolgáltató fiókonként egyszerre csak egy adatfolyamot engedélyez. Állítsa le az ugyanehhez a fiókhoz tartozó egyéb lejátszási vagy letöltési folyamatokat, majd próbálja újra."

#: catchup_urls.py:82
msgid "The provider rejected the request (HTTP 4xx error)."
msgstr "A szolgáltató elutasította a kérést (HTTP 4xx hiba)."

#: catchup_urls.py:84
msgid "The provider's server had an error (HTTP 5xx). Try again later."
msgstr "Hiba történt a szolgáltató kiszolgálóján (HTTP 5xx). Próbálja újra később."

#: catchup_urls.py:91
msgid "The provider's server refused the connection."
msgstr "A szolgáltató kiszolgálója elutasította a kapcsolatot."

