#: CHANGELOG.md:10
msgid "Add MPV session adapter for subtitle text via JSON IPC (issue #37)"
msgstr "Dodano adapter sesji MPV dla tekstu napisów przez JSON IPC (issue #37)"

#: CHANGELOG.md:9
msgid "Add application-owned TTS backend with volume and output selection (issue #37)"
msgstr "Dodano własny mechanizm TTS aplikacji z głośnością i wyborem wyjścia (issue #37)"

#: CHANGELOG.md:11
msgid "Add player-independent subtitle speech manager (issue #37)"
msgstr "Dodano niezależny od odtwarzacza menedżer czytania napisów (issue #37)"

#: CHANGELOG.md:23
msgid "Stop a waiting reconnect from restarting a newly chosen channel (#43)"
msgstr "Oczekujące ponowne połączenie nie uruchamia już ponownie nowo wybranego kanału (#43)"

#: CHANGELOG.md:17
msgid "Stop hanging on a channel whose streams are all offline (#44)"
msgstr "Program nie zawiesza się już na kanale, którego wszystkie strumienie są niedostępne (#44)"

#: CHANGELOG.md:8
msgid "Wire MPV subtitle speech, backend choice and capability report into the app (issue #37)"
msgstr "Zintegrowano czytanie napisów MPV, wybór mechanizmu i raport możliwości z aplikacją (issue #37)"

