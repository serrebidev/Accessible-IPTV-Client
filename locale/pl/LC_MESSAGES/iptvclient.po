#: internal_player.py
msgid "Resume playback from {time}?"
msgstr "Wznowić odtwarzanie od {time}?"

#: internal_player.py
msgid "The saved playback position could not be restored."
msgstr "Nie udało się przywrócić zapisanej pozycji odtwarzania."

msgid "External subtitle files are not synchronized with the local live buffer. Use the stream's embedded subtitles."
msgstr "Zewnętrzne pliki napisów nie są zsynchronizowane z lokalnym buforem transmisji. Użyj napisów osadzonych w strumieniu."

msgid "Fade-out duration before stopping (seconds); 0 disables fading."
msgstr "Czas stopniowego wyciszania przed zatrzymaniem (sekundy); 0 wyłącza wyciszanie."

msgid "Keep up to this many minutes of live TV (1–30); 0 disables the local buffer."
msgstr "Przechowuj od 1 do 30 minut transmisji na żywo; 0 wyłącza lokalny bufor."

msgid "Live input ended; retained history is still available."
msgstr "Transmisja na żywo zakończyła się; zachowana historia jest nadal dostępna."

msgid "Local Live Buffer"
msgstr "Lokalny bufor transmisji"

msgid "Local Live Buffer..."
msgstr "Lokalny bufor transmisji…"

msgid "Maximum local buffer size per session (MiB). Old data is removed when either limit is reached."
msgstr "Maksymalny rozmiar lokalnego bufora na sesję (MiB). Najstarsze dane są usuwane po osiągnięciu dowolnego limitu."

msgid "MiB:"
msgstr "MiB:"

msgid "No local live history is available."
msgstr "Brak lokalnej historii transmisji na żywo."

msgid "Playback volume is fading before the sleep timer stops it."
msgstr "Głośność odtwarzania jest stopniowo zmniejszana przed zatrzymaniem przez wyłącznik czasowy."

msgid "Return to Live"
msgstr "Wróć do transmisji na żywo"

msgid "Rewind Live TV"
msgstr "Przewiń transmisję wstecz"

msgid "Rewind Live TV..."
msgstr "Przewiń transmisję wstecz…"

msgid "Seconds behind the latest buffered picture; 0 returns to live."
msgstr "Opóźnienie w sekundach względem najnowszego zapisanego obrazu; 0 powraca do transmisji na żywo."

msgid "Seconds:"
msgstr "Sekundy:"

msgid "Stop local buffered playback before switching to a cast device."
msgstr "Zatrzymaj lokalne odtwarzanie z bufora przed przełączeniem na urządzenie do przesyłania."

msgid "The local buffer is still feeding a recording. Stop the recording before disabling it."
msgstr "Lokalny bufor nadal zasila nagrywanie. Zatrzymaj je przed wyłączeniem bufora."

msgid "The local buffer stopped because its storage or input failed."
msgstr "Lokalny bufor zatrzymał się z powodu błędu pamięci lub źródła."

msgid "The local live buffer could not start. No extra provider connection was opened. Disable the buffer to retry direct playback."
msgstr "Nie udało się uruchomić lokalnego bufora. Nie otwarto dodatkowego połączenia z dostawcą. Wyłącz bufor, aby ponowić bezpośrednie odtwarzanie."

msgid "The old buffered position expired; playback moved to the retained window."
msgstr "Poprzednia pozycja wygasła; odtwarzanie przeniesiono do zachowanego zakresu."

msgid "The paused position expired. Playback resumed at the oldest retained picture."
msgstr "Wstrzymana pozycja wygasła. Odtwarzanie wznowiono od najstarszego zachowanego obrazu."
