#: CHANGELOG.md:14
msgid "A failed cast from the player no longer blocks Teleelevidenie"
msgstr "L'échec d'une diffusion depuis le lecteur ne bloque plus Teleelevidenie"

#: CHANGELOG.md:21
msgid "An audio-only recording format chosen on a TV channel is used"
msgstr "Le format d'enregistrement audio seul choisi sur une chaîne TV est utilisé"

#: CHANGELOG.md:22
msgid "Catch-up downloads on Teleelevidenie find the programme file again"
msgstr "Les téléchargements de replay Teleelevidenie retrouvent le fichier du programme"

#: CHANGELOG.md:20
msgid "The player keeps keyboard focus after a failed cast"
msgstr "Le lecteur garde le focus clavier après l'échec d'une diffusion"

#: CHANGELOG.md:8
msgid "Windows catch-up downloads work with incomplete certificate chains"
msgstr "Les téléchargements de programmes en rattrapage sous Windows fonctionnent avec des chaînes de certificats incomplètes"

