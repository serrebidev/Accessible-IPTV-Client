#: internal_player.py
msgid "Resume playback from {time}?"
msgstr "क्या {time} से प्लेबैक फिर शुरू करें?"

#: internal_player.py
msgid "The saved playback position could not be restored."
msgstr "सहेजी गई प्लेबैक स्थिति बहाल नहीं हो सकी।"

msgid "External subtitle files are not synchronized with the local live buffer. Use the stream's embedded subtitles."
msgstr "बाहरी उपशीर्षक फ़ाइलें स्थानीय लाइव बफ़र के साथ समन्वित नहीं हैं। स्ट्रीम में समाहित उपशीर्षकों का उपयोग करें।"

msgid "Fade-out duration before stopping (seconds); 0 disables fading."
msgstr "रोकने से पहले धीरे-धीरे आवाज़ कम करने की अवधि (सेकंड); 0 से यह बंद हो जाता है।"

msgid "Keep up to this many minutes of live TV (1–30); 0 disables the local buffer."
msgstr "लाइव टीवी के 1–30 मिनट सुरक्षित रखें; 0 से स्थानीय बफ़र बंद होता है।"

msgid "Live input ended; retained history is still available."
msgstr "लाइव इनपुट समाप्त हो गया; सुरक्षित इतिहास अब भी उपलब्ध है।"

msgid "Local Live Buffer"
msgstr "स्थानीय लाइव बफ़र"

msgid "Local Live Buffer..."
msgstr "स्थानीय लाइव बफ़र…"

msgid "Maximum local buffer size per session (MiB). Old data is removed when either limit is reached."
msgstr "प्रति सत्र स्थानीय बफ़र का अधिकतम आकार (MiB)। किसी भी सीमा तक पहुँचने पर सबसे पुराना डेटा हटाया जाता है।"

msgid "MiB:"
msgstr "MiB:"

msgid "No local live history is available."
msgstr "स्थानीय लाइव इतिहास उपलब्ध नहीं है।"

msgid "Playback volume is fading before the sleep timer stops it."
msgstr "स्लीप टाइमर द्वारा प्लेबैक रोकने से पहले आवाज़ धीरे-धीरे कम हो रही है।"

msgid "Return to Live"
msgstr "लाइव पर लौटें"

msgid "Rewind Live TV"
msgstr "लाइव टीवी पीछे करें"

msgid "Rewind Live TV..."
msgstr "लाइव टीवी पीछे करें…"

msgid "Seconds behind the latest buffered picture; 0 returns to live."
msgstr "सबसे नई सुरक्षित तस्वीर से देरी (सेकंड); 0 से लाइव पर लौटते हैं।"

msgid "Seconds:"
msgstr "सेकंड:"

msgid "Stop local buffered playback before switching to a cast device."
msgstr "कास्ट डिवाइस पर जाने से पहले स्थानीय बफ़र से प्लेबैक रोकें।"

msgid "The local buffer is still feeding a recording. Stop the recording before disabling it."
msgstr "स्थानीय बफ़र अभी रिकॉर्डिंग को डेटा दे रहा है। इसे बंद करने से पहले रिकॉर्डिंग रोकें।"

msgid "The local buffer stopped because its storage or input failed."
msgstr "स्टोरेज या इनपुट की समस्या के कारण स्थानीय बफ़र रुक गया।"

msgid "The local live buffer could not start. No extra provider connection was opened. Disable the buffer to retry direct playback."
msgstr "स्थानीय लाइव बफ़र शुरू नहीं हो सका। प्रदाता से कोई अतिरिक्त कनेक्शन नहीं खोला गया। सीधे प्लेबैक का फिर प्रयास करने के लिए बफ़र बंद करें।"

msgid "The old buffered position expired; playback moved to the retained window."
msgstr "पुरानी स्थिति अब उपलब्ध नहीं है; प्लेबैक सुरक्षित दायरे में चला गया है।"

msgid "The paused position expired. Playback resumed at the oldest retained picture."
msgstr "विराम की स्थिति अब उपलब्ध नहीं है। सबसे पुरानी सुरक्षित तस्वीर से प्लेबैक फिर शुरू हुआ।"
