#: CHANGELOG.md:10
msgid "Add MPV session adapter for subtitle text via JSON IPC (issue #37)"
msgstr "JSON IPC üzerinden altyazı metni için MPV oturum bağdaştırıcısı eklendi (issue #37)"

#: CHANGELOG.md:9
msgid "Add application-owned TTS backend with volume and output selection (issue #37)"
msgstr "Ses düzeyi ve çıkış seçimi ile uygulamaya ait TTS altyapısı eklendi (issue #37)"

#: CHANGELOG.md:11
msgid "Add player-independent subtitle speech manager (issue #37)"
msgstr "Oynatıcıdan bağımsız altyazı seslendirme yöneticisi eklendi (issue #37)"

#: CHANGELOG.md:23
msgid "Stop a waiting reconnect from restarting a newly chosen channel (#43)"
msgstr "Bekleyen yeniden bağlanma artık yeni seçilen kanalı yeniden başlatmıyor (#43)"

#: CHANGELOG.md:17
msgid "Stop hanging on a channel whose streams are all offline (#44)"
msgstr "Tüm yayınları çevrimdışı olan bir kanalda artık takılıp kalmıyor (#44)"

#: CHANGELOG.md:8
msgid "Wire MPV subtitle speech, backend choice and capability report into the app (issue #37)"
msgstr "MPV altyazı seslendirme, altyapı seçimi ve özellik raporu uygulamaya bağlandı (issue #37)"

