#: internal_player.py
msgid "The saved playback position could not be restored."
msgstr "Kaydedilen oynatma konumu geri yüklenemedi."

msgid "External subtitle files are not synchronized with the local live buffer. Use the stream's embedded subtitles."
msgstr "Harici altyazı dosyaları yerel canlı yayın arabelleğiyle eşzamanlı değildir. Akışın gömülü altyazılarını kullanın."

msgid "Fade-out duration before stopping (seconds); 0 disables fading."
msgstr "Durdurmadan önce sesi kademeli azaltma süresi (saniye); 0 bu özelliği kapatır."

msgid "Keep up to this many minutes of live TV (1–30); 0 disables the local buffer."
msgstr "Canlı yayının 1–30 dakikasını saklayın; 0 yerel arabelleği kapatır."

msgid "Live input ended; retained history is still available."
msgstr "Canlı giriş sona erdi; saklanan geçmiş kullanılabilir durumda."

msgid "Local Live Buffer"
msgstr "Yerel Canlı Yayın Arabelleği"

msgid "Local Live Buffer..."
msgstr "Yerel Canlı Yayın Arabelleği…"

msgid "Maximum local buffer size per session (MiB). Old data is removed when either limit is reached."
msgstr "Oturum başına en fazla yerel arabellek boyutu (MiB). Sınırlardan birine ulaşılınca en eski veriler silinir."

msgid "MiB:"
msgstr "MiB:"

msgid "No local live history is available."
msgstr "Yerel canlı yayın geçmişi bulunmuyor."

msgid "Playback volume is fading before the sleep timer stops it."
msgstr "Uyku zamanlayıcısı oynatmayı durdurmadan önce ses kademeli olarak azaltılıyor."

msgid "Return to Live"
msgstr "Canlı Yayına Dön"

msgid "Rewind Live TV"
msgstr "Canlı Yayını Geri Sar"

msgid "Rewind Live TV..."
msgstr "Canlı Yayını Geri Sar…"

msgid "Seconds behind the latest buffered picture; 0 returns to live."
msgstr "En son saklanan görüntüye göre gecikme (saniye); 0 canlı yayına döner."

msgid "Seconds:"
msgstr "Saniye:"

msgid "Stop local buffered playback before switching to a cast device."
msgstr "Bir yayın cihazına geçmeden önce yerel arabellekten oynatmayı durdurun."

msgid "The local buffer is still feeding a recording. Stop the recording before disabling it."
msgstr "Yerel arabellek hâlâ bir kayda veri sağlıyor. Kapatmadan önce kaydı durdurun."

msgid "The local buffer stopped because its storage or input failed."
msgstr "Depolama veya giriş hatası nedeniyle yerel arabellek durdu."

msgid "The local live buffer could not start. No extra provider connection was opened. Disable the buffer to retry direct playback."
msgstr "Yerel canlı yayın arabelleği başlatılamadı. Sağlayıcıya ek bağlantı açılmadı. Doğrudan oynatmayı yeniden denemek için arabelleği kapatın."

msgid "The old buffered position expired; playback moved to the retained window."
msgstr "Eski konumun süresi doldu; oynatma saklanan aralığa taşındı."

msgid "The paused position expired. Playback resumed at the oldest retained picture."
msgstr "Duraklatılan konumun süresi doldu. Oynatma saklanan en eski görüntüden sürdürüldü."
